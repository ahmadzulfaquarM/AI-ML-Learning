import numpy as np
arr=np.array([2,3,4,6,7,8,9,12,13,16,17,23,25,27,34,37,201])
arr


Q1=np.percentile(arr,25)
Q3=np.percentile(arr,75)



IQR=(Q3-Q1)


UF=Q3+1.5*(IQR)
LF=Q1-1.5*(IQR)


l=[]
for i in arr:
   if i>=LF and i<=UF:
       l.append(i)


l=np.array(l)
l


import seaborn as sns
sns.boxplot(x=l)



